{
  "name": "fullstack-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "Unit-1/exp1/*",
    "Unit-1/exp2/*"
  ],
  "scripts": {
    "dev:exp1-easy": "npm run dev --workspace=Unit-1/exp1/easy",
    "dev:exp1-medium": "npm run dev --workspace=Unit-1/exp1/medium",
    "dev:exp1-hard": "npm run dev --workspace=Unit-1/exp1/hard",
    "dev:exp2-easy": "npm run dev --workspace=Unit-1/exp2/easy",
    "dev:exp2-medium": "npm run dev --workspace=Unit-1/exp2/medium",
    "dev:exp2-hard": "npm run dev --workspace=Unit-1/exp2/hard"
  },
  "dependencies": {
    "react-router-dom": "^7.18.2"
  }
}
